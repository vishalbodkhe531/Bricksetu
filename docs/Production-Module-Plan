### Phase 1: Types, Schemas & Constants

#### [MODIFY] [production.types.ts](file:///d:/Development/Personal-Projects/brick-setu/features/production/types/production.types.ts)

Replace the existing simple types with comprehensive ones aligned to the DB schema:

```typescript
// Batch (maps to `batches` table)
export interface Batch {
  id: string;
  business_unit_id: string;
  batch_number: string;
  brick_type_id: string;
  stage: BatchStage;
  target_quantity: number;
  moulded_quantity: number;
  dried_quantity: number;
  fired_good_quantity: number;
  damaged_quantity: number;
  start_date: string;
  end_date: string | null;
  status: BatchStatus;
  notes: string | null;
  created_at: string;
  created_by: string | null;
  // Joined
  brick_type?: { id: string; name: string; dimensions: string | null };
  created_by_name?: string;
  // Computed
  total_consumption_cost?: number;    // sum of consumption cost_paise
  total_expense_cost?: number;        // sum of expenses amount_paise
  stage_transition_count?: number;
  moulding_log_count?: number;
}

export type BatchStage = 'MOULDING' | 'DRYING' | 'FIRING' | 'SORTING' | 'COMPLETED';
export type BatchStatus = 'IN_PROGRESS' | 'COMPLETED' | 'CANCELLED';

// Stage Transition (maps to `stage_transitions` table)
export interface StageTransition {
  id: string;
  batch_id: string;
  from_stage: BatchStage;
  to_stage: BatchStage;
  transition_date: string;
  input_quantity: number;
  output_good_quantity: number;
  damaged_quantity: number;
  notes: string | null;
  created_at: string;
  created_by_name?: string;
}

// Material Consumption (maps to `consumption` table)
export interface MaterialConsumption {
  id: string;
  batch_id: string;
  material_lot_id: string;
  consumption_date: string;
  quantity: number;          // decimal
  cost_paise: number;
  notes: string | null;
  // Joined
  material_name?: string;
  material_unit?: string;
  lot_number?: string;
}

// Daily Moulding Log (maps to `daily_moulding_logs` table)
export interface MouldingLog {
  id: string;
  batch_id: string;
  worker_id: string;
  work_date: string;
  bricks_moulded: number;
  rate_per_1000_paise: number;
  earned_amount_paise: number;
  settlement_id: string | null;
  notes: string | null;
  // Joined
  worker_name?: string;
}

// Batch KPI summary
export interface BatchKPIs {
  target_quantity: number;
  moulded_quantity: number;
  dried_quantity: number;
  fired_good_quantity: number;
  damaged_quantity: number;
  yield_percentage: number;         // (fired_good / moulded) * 100
  wastage_percentage: number;       // (damaged / moulded) * 100
  total_material_cost: number;      // paise
  total_expense_cost: number;       // paise
  cost_per_brick_paise: number;     // total cost / fired_good
  total_moulding_labour_cost: number; // sum of moulding log earned_amount
  days_in_production: number;
}
```

