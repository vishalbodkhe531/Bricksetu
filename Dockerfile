# ------------------------------------------------------------------------------
# Stage 1: Base image
# ------------------------------------------------------------------------------
FROM node:22-alpine AS base

# Install dependencies required by Next.js and Prisma on Alpine Linux (musl)
RUN apk add --no-cache libc6-compat openssl

WORKDIR /app

# ------------------------------------------------------------------------------
# Stage 2: Install dependencies (cached if package files don't change)
# ------------------------------------------------------------------------------
FROM base AS deps

# Copy package manifests
COPY package.json package-lock.json ./

# Copy Prisma schema and config (needed because npm ci triggers "postinstall": "prisma generate")
COPY prisma.config.ts ./
COPY prisma ./prisma

# Fallback environment variables for Prisma config during generation
ENV DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"
ENV DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Install all dependencies (use npm install with legacy-peer-deps to prevent strict lockfile sync mismatch)
RUN npm install --legacy-peer-deps

# ------------------------------------------------------------------------------
# Stage 3: Build application
# ------------------------------------------------------------------------------
FROM base AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy full application source
COPY . .

# Build-time environment arguments for Next.js public variables (passed via --build-arg or CI/CD)
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY

# Disable Next.js anonymous telemetry
ENV NEXT_TELEMETRY_DISABLED=1

# Fallback environment variables for Prisma configuration during build
ENV DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"
ENV DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Build the Next.js application (runs "prisma generate && next build")
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 4: Production Runner (minimal final image)
# ------------------------------------------------------------------------------
FROM base AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Create a non-root system user and group for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy static assets and standalone server output generated by Next.js
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

# Run container as non-root user
USER nextjs

# Expose container port
EXPOSE 3000

# Start Next.js standalone server
CMD ["node", "server.js"]
