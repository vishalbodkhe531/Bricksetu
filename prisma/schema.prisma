generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["app_auth", "audit", "core", "finance", "inventory", "materials", "parties", "production", "sales", "transport", "workers"]
}

model sessions {
  id         String   @id @db.VarChar(255)
  user_id    String   @db.Uuid
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_sessions_user_id")
  @@schema("app_auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                                         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id                           String                @db.Uuid
  username                                   String                @unique @db.VarChar(100)
  email                                      String                @unique @db.VarChar(255)
  password_hash                              String                @db.VarChar(255)
  full_name                                  String                @db.VarChar(255)
  role                                       String                @default("ADMIN") @db.VarChar(50)
  is_active                                  Boolean               @default(true)
  created_at                                 DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at                                 DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  sessions                                   sessions[]
  business_units                             business_units        @relation(fields: [business_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  events                                     events[]
  allocations                                allocations[]
  charges                                    charges[]
  expenses                                   expenses[]
  payments                                   payments[]
  settlements_settlements_approved_byTousers settlements[]         @relation("settlements_approved_byTousers")
  settlements_settlements_created_byTousers  settlements[]         @relation("settlements_created_byTousers")
  settlements_settlements_voided_byTousers   settlements[]         @relation("settlements_voided_byTousers")
  stock_adjustments                          stock_adjustments[]
  stock_ledger                               stock_ledger[]
  consumption                                consumption[]
  purchases                                  purchases[]
  batches                                    batches[]
  daily_moulding_logs                        daily_moulding_logs[]
  stage_transitions                          stage_transitions[]
  records                                    records[]
  trips                                      trips[]
  rate_history                               rate_history[]

  @@index([business_unit_id], map: "idx_users_business_unit")
  @@schema("app_auth")
}

model events {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id String?         @db.Uuid
  actor_id         String?         @db.Uuid
  action           String          @db.VarChar(100)
  entity_type      String          @db.VarChar(100)
  entity_id        String?         @db.Uuid
  metadata         Json?
  created_at       DateTime        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  users            users?          @relation(fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  business_units   business_units? @relation(fields: [business_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([business_unit_id, created_at(sort: Desc)], map: "idx_audit_events_bu_date")
  @@index([entity_type, entity_id], map: "idx_audit_events_entity")
  @@schema("audit")
}

model brick_grades {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id String          @db.Uuid
  code             String          @db.VarChar(50)
  name             String          @db.VarChar(100)
  description      String?
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  business_units   business_units  @relation(fields: [business_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finished_lots    finished_lots[]
  stock_ledger     stock_ledger[]
  records          records[]

  @@unique([business_unit_id, code], map: "unique_brick_grade_code")
  @@schema("core")
}

model brick_types {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id String          @db.Uuid
  code             String          @db.VarChar(50)
  name             String          @db.VarChar(100)
  dimensions       String?         @db.VarChar(100)
  description      String?
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  business_units   business_units  @relation(fields: [business_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  finished_lots    finished_lots[]
  stock_ledger     stock_ledger[]
  batches          batches[]
  records          records[]

  @@unique([business_unit_id, code], map: "unique_brick_type_code")
  @@schema("core")
}

model business_units {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String               @unique @db.VarChar(50)
  name               String               @db.VarChar(255)
  address            String?
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at         DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  users              users[]
  events             events[]
  brick_grades       brick_grades[]
  brick_types        brick_types[]
  expense_categories expense_categories[]
  charges            charges[]
  expenses           expenses[]
  payments           payments[]
  settlements        settlements[]
  finished_lots      finished_lots[]
  stock_adjustments  stock_adjustments[]
  stock_ledger       stock_ledger[]
  catalogue          catalogue[]
  consumption        consumption[]
  lots               lots[]
  purchases          purchases[]
  customers          customers[]
  suppliers          suppliers[]
  batches            batches[]
  records            records[]
  trips              trips[]
  vehicles           vehicles[]
  profiles           profiles[]

  @@schema("core")
}

model expense_categories {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id String         @db.Uuid
  code             String         @db.VarChar(50)
  name             String         @db.VarChar(100)
  description      String?
  is_active        Boolean        @default(true)
  created_at       DateTime       @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  business_units   business_units @relation(fields: [business_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expenses         expenses[]

  @@unique([business_unit_id, code], map: "unique_expense_category_code")
  @@schema("core")
}

model material_units {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String      @unique @db.VarChar(50)
  name      String      @db.VarChar(50)
  catalogue catalogue[]

  @@schema("core")
}

model payment_methods {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String     @unique @db.VarChar(50)
  name     String     @db.VarChar(50)
  expenses expenses[]
  payments payments[]

  @@schema("core")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model allocations {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id   String   @db.Uuid
  charge_id    String   @db.Uuid
  amount_paise BigInt
  created_at   DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by   String?  @db.Uuid
  charges      charges  @relation(fields: [charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users?   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments     payments @relation(fields: [payment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([charge_id], map: "idx_allocations_charge")
  @@index([payment_id], map: "idx_allocations_payment")
  @@schema("finance")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model charges {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id       String         @db.Uuid
  party_type             String         @db.VarChar(50)
  party_id               String?        @db.Uuid
  charge_type            String         @db.VarChar(50)
  reference_id           String?        @db.Uuid
  charge_date            DateTime       @db.Date
  amount_paise           BigInt
  allocated_amount_paise BigInt         @default(0)
  status                 String         @default("UNPAID") @db.VarChar(50)
  description            String?
  created_at             DateTime       @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by             String?        @db.Uuid
  allocations            allocations[]
  business_units         business_units @relation(fields: [business_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                  users?         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expenses               expenses[]
  settlements            settlements[]

  @@index([business_unit_id, party_type, party_id], map: "idx_charges_bu_party")
  @@schema("finance")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expenses {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id   String             @db.Uuid
  category_id        String             @db.Uuid
  batch_id           String?            @db.Uuid
  expense_date       DateTime           @db.Date
  amount_paise       BigInt
  payee_name         String?            @db.VarChar(255)
  payment_method_id  String             @db.Uuid
  charge_id          String?            @db.Uuid
  notes              String?
  created_at         DateTime           @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by         String?            @db.Uuid
  batches            batches?           @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  business_units     business_units     @relation(fields: [business_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  expense_categories expense_categories @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  charges            charges?           @relation(fields: [charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users              users?             @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_methods    payment_methods    @relation(fields: [payment_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([business_unit_id, expense_date(sort: Desc)], map: "idx_expenses_bu_date")
  @@schema("finance")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model payments {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id       String          @db.Uuid
  payment_number         String          @db.VarChar(100)
  direction              String          @db.VarChar(20)
  party_type             String          @db.VarChar(50)
  party_id               String?         @db.Uuid
  payment_date           DateTime        @db.Date
  amount_paise           BigInt
  allocated_amount_paise BigInt          @default(0)
  payment_method_id      String          @db.Uuid
  reference_number       String?         @db.VarChar(100)
  notes                  String?
  created_at             DateTime        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by             String?         @db.Uuid
  allocations            allocations[]
  business_units         business_units  @relation(fields: [business_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                  users?          @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment_methods        payment_methods @relation(fields: [payment_method_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([business_unit_id, payment_number], map: "unique_payment_number")
  @@index([business_unit_id, party_type, party_id], map: "idx_payments_bu_party")
  @@schema("finance")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model settlements {
  id                                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id                     String                @db.Uuid
  settlement_number                    String                @db.VarChar(100)
  worker_id                            String                @db.Uuid
  period_start_date                    DateTime              @db.Date
  period_end_date                      DateTime              @db.Date
  total_bricks                         Int
  gross_amount_paise                   BigInt
  status                               String                @default("DRAFT") @db.VarChar(50)
  approved_at                          DateTime?             @db.Timestamptz(6)
  approved_by                          String?               @db.Uuid
  voided_at                            DateTime?             @db.Timestamptz(6)
  voided_by                            String?               @db.Uuid
  void_reason                          String?
  charge_id                            String?               @db.Uuid
  notes                                String?
  created_at                           DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by                           String?               @db.Uuid
  users_settlements_approved_byTousers users?                @relation("settlements_approved_byTousers", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  business_units                       business_units        @relation(fields: [business_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  charges                              charges?              @relation(fields: [charge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_settlements_created_byTousers  users?                @relation("settlements_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_settlements_voided_byTousers   users?                @relation("settlements_voided_byTousers", fields: [voided_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
