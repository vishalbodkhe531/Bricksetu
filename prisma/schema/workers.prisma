/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model profiles {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id        String                @db.Uuid
  code                    String                @db.VarChar(50)
  full_name               String                @db.VarChar(255)
  phone                   String?               @db.VarChar(20)
  alternate_phone         String?               @db.VarChar(20)
  address                 String?
  id_proof_type           String?               @db.VarChar(50)
  id_proof_number         String?               @db.VarChar(100)
  photo_url               String?
  dob                     DateTime?             @db.Date
  gender                  String?               @db.VarChar(20)
  emergency_contact_name  String?               @db.VarChar(255)
  emergency_contact_phone String?               @db.VarChar(20)
  emergency_relationship  String?               @db.VarChar(50)
  payment_type            String                @default("PIECE_RATE") @db.VarChar(50)
  joining_date            DateTime              @db.Date
  total_decided_advance_amount BigInt?               @default(0)
  is_active               Boolean               @default(true)
  archived_at             DateTime?             @db.Timestamptz(6)
  created_at              DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at              DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  settlements             settlements[]
  daily_moulding_logs     daily_moulding_logs[]
  daily_work_logs         daily_work_logs[]
  business_units          business_units        @relation(fields: [business_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rate_history            rate_history[]

  @@unique([business_unit_id, code], map: "unique_worker_code_per_bu")
  @@index([business_unit_id], map: "idx_workers_bu")
  @@schema("workers")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model rate_history {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  worker_id           String   @db.Uuid
  effective_date      DateTime @db.Date
  rate_per_1000_paise BigInt
  created_at          DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by          String?  @db.Uuid
  users               users?   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profiles            profiles @relation(fields: [worker_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([worker_id, effective_date], map: "unique_worker_rate_effective_date")
  @@index([worker_id, effective_date(sort: Desc)], map: "idx_worker_rate_lookup")
  @@schema("workers")
}

model daily_work_logs {
  id                            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id              String         @db.Uuid
  worker_id                     String         @db.Uuid
  work_date                     DateTime       @db.Date
  category                      String         @db.VarChar(50)
  entry_mode                    String         @db.VarChar(20)
  input_quantity                Decimal        @db.Decimal(10, 2)
  physical_quantity             Decimal        @db.Decimal(10, 2)
  billable_quantity             Decimal        @db.Decimal(10, 2)
  unit                          String         @db.VarChar(20)
  conversion_physical_per_unit  Int?
  conversion_billable_per_unit  Int?
  rate_paise                    BigInt
  earned_amount_paise           BigInt
  batch_id                      String?        @db.Uuid
  reference_no                  String?        @db.VarChar(100)
  notes                         String?
  settlement_id                 String?        @db.Uuid
  created_at                    DateTime       @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  created_by                    String?        @db.Uuid

  profiles                      profiles       @relation(fields: [worker_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  business_units                business_units @relation(fields: [business_unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  settlements                   settlements?   @relation(fields: [settlement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batches                       batches?       @relation(fields: [batch_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                         users?         @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([worker_id, work_date], map: "idx_work_logs_worker_date")
  @@index([business_unit_id, category, work_date], map: "idx_work_logs_bu_cat_date")
  @@schema("workers")
}

model work_unit_conversions {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_unit_id         String         @db.Uuid
  category                 String         @db.VarChar(50)
  unit_name                String         @db.VarChar(20)
  physical_count_per_unit  Int
  billable_count_per_unit  Int
  effective_from           DateTime       @db.Date
  is_active                Boolean        @default(true)
  created_at               DateTime       @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  business_units           business_units @relation(fields: [business_unit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([business_unit_id, category, unit_name, effective_from])
  @@schema("workers")
}

